<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.embedding.NavigationTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.openlauncher.app.debug.SELECT_NAVIGATION_PROVIDER" />
                <action android:name="com.openlauncher.app.debug.NAVIGATION_GESTURE" />
                <action android:name="com.openlauncher.app.debug.NAVIGATION_TYPE" />
                <action android:name="com.openlauncher.app.debug.NAVIGATION_BACK" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".debug.embedding.ActivityViewPocActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="landscape" />
        <activity
            android:name=".debug.embedding.ActivityViewWidgetPocActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:screenOrientation="landscape" />
        <activity
            android:name=".debug.embedding.VirtualDisplayPocActivity"
            android:exported="true"
            android:screenOrientation="landscape" />
        <activity
            android:name=".debug.embedding.EmbeddedProbeActivity"
            android:allowEmbedded="true"
            android:exported="true"
            android:resizeableActivity="true" />
    </application>
</manifest>
